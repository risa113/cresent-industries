<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" fill="none">
  <!-- Outer Structural Precision Hexagon -->
  <polygon points="50,4 92,26 92,74 50,96 8,74 8,26" stroke="#2563EB" stroke-width="3" fill="#0F172A" />
  
  <!-- Steel Grid Lines -->
  <line x1="8" y1="26" x2="92" y2="74" stroke="#1E293B" stroke-width="1.5" />
  <line x1="8" y1="74" x2="92" y2="26" stroke="#1E293B" stroke-width="1.5" />
  <line x1="50" y1="4" x2="50" y2="96" stroke="#1E293B" stroke-width="1.5" />
  
  <!-- Architectural Crescent Silhouette in High-Grade Cyan/Blue -->
  <path d="M50 16 C30 16 16 32 16 52 C16 72 32 86 52 86 C64 86 74 80 80 72 C60 76 40 64 36 44 C34 32 40 22 50 16 Z" fill="url(#crescentGradient)" />
  
  <!-- Central Structural PEB Beam Portal (Orange/Gold Accent) -->
  <path d="M48 38 L68 50 L68 62 L48 50 Z" fill="#F97316" />
  <path d="M68 50 L84 40 L84 52 L68 62 Z" fill="#FB923C" />
  
  <!-- Precision Truss Nodes -->
  <circle cx="50" cy="50" r="3" fill="#FFFFFF" />
  <circle cx="68" cy="62" r="2.5" fill="#FFFFFF" />
  <circle cx="48" cy="38" r="2.5" fill="#FFFFFF" />
  
  <defs>
    <linearGradient id="crescentGradient" x1="16" y1="16" x2="80" y2="86" gradientUnits="userSpaceOnUse">
      <stop stop-color="#38BDF8" />
      <stop offset="0.5" stop-color="#2563EB" />
      <stop offset="1" stop-color="#1D4ED8" />
    </linearGradient>
  </defs>
</svg>
